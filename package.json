{
  "name": "epoch-buddy",
  "version": "1.8.2",
  "private": true,
  "description": "Convert Epoch to Human Readable Time — browser extension and demo site",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:chrome": "node scripts/build.mjs --browser chrome",
    "build:firefox": "node scripts/build.mjs --browser firefox",
    "watch": "node scripts/build.mjs --watch",
    "watch:chrome": "node scripts/build.mjs --watch --browser chrome",
    "watch:firefox": "node scripts/build.mjs --watch --browser firefox",
    "pack": "node scripts/build.mjs --pack",
    "pack:chrome": "node scripts/build.mjs --pack chrome",
    "pack:firefox": "node scripts/build.mjs --pack firefox",
    "check:secrets": "node scripts/check-secrets.mjs",
    "sanitize:analytics-config": "node scripts/sanitize-analytics-config.mjs",
    "gen:store": "node scripts/gen-store-images.mjs",
    "gen:store:pages": "node scripts/gen-store-images.mjs --pages-only",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.25.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "playwright": "^1.49.0",
    "prettier": "^3.8.4",
    "sharp": "^0.33.5"
  }
}
